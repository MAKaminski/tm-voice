  "cards": [
    {
      "dot": "rose",
      "title": "The rule everything bends around",
      "items": [
        "No code path reaches Telnyx or Vapi without CALL_TASK.gate_result = 'pass' written in the same transaction",
        "DIAL_MODE (dry_run | verified_only | live) is enforced in the adapters, never in the UI",
        "SUPPRESSION is unique on phone_e164 and is never keyed on a contact"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two inbound edges, one destination",
      "items": [
        "Vapi posts tool calls during a call and an end-of-call report at the end",
        "Telnyx posts carrier events — hangup cause and per-leg cost — to /webhooks/telnyx",
        "Discord capture uploads speaker tracks to R2 and files commitments as TM-OS tasks"
      ]
    },
    {
      "dot": "cyan",
      "title": "Patterns, not exceptions",
      "items": [
        "Vendor SDKs are imported only inside packages/adapters/<vendor>",
        "Every external write is a BullMQ job with the standard envelope and an idempotency key",
        "The API and the worker read and write the same Drizzle schema",
        "Replay any dead job with pnpm replay <queue> <job_id>"
      ]
    }
  ]
