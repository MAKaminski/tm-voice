# TM Voice — environment manifest (copy to .env locally; Railway variables in production).
# Must match packages/shared/src/config.ts exactly — the config loader fails fast on drift.
# Every value lives in 1Password vault "TM Voice" and in Railway variables — nowhere else. Never commit a filled copy.
# In DIAL_MODE=dry_run every vendor key may be blank; adapters return mocks. Outside dry_run all vendor keys are required.

# --- Platform (Railway-managed) ---
DATABASE_URL=postgres://tm:tm@localhost:5432/tm_voice        # Railway Postgres plugin. Local no-Docker dev: pglite:./.data/pglite
REDIS_URL=redis://localhost:6379                             # Railway Redis plugin (optional in dry_run: api runs jobs inline)
APP_BASE_URL=http://localhost:3000                           # console public URL (Railway domain)
API_BASE_URL=http://localhost:8787                           # api URL as seen by the console
PORT=8787
INTERNAL_API_TOKEN=change-me-32-random-chars                 # generated; console <-> api. 1Password: TM Voice / internal

# --- Policy switches (decisions, not secrets) ---
DIAL_MODE=dry_run                                            # dry_run | verified_only | live — the go-live switch
DIAL_ALLOWLIST=                                              # comma-separated E.164; required when DIAL_MODE=verified_only
COMPLIANCE_TARGET_SURFACE=landline_only                      # landline_only | consented_mobile (flip only after Phase 7)
DNC_SCRUB=required                                           # required | off — off skips the registry lookup and drops DNC_API_KEY from the dial-path keys; cached hits still block. Logged at boot, shown by /health
AUTO_BOOK=false                                              # settled: a human reviews every booking
ALLOW_MA_RECORDING=false                                     # MA is two-party; keep false unless an affirmative consent flow exists

# --- Apollo (1Password: TM Voice / Apollo) — MASTER key required for POST /phone_calls ---
APOLLO_API_KEY=

# --- Housecall Pro (TM Voice / Housecall Pro) — MAX plan, Admin > My Apps > App Store > API Key Management ---
HCP_API_KEY=

# --- Telnyx (TM Voice / Telnyx) — Mission Control; account must reach Verified tier before the first real dial ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# --- Vapi (TM Voice / Vapi) ---
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=

# --- Deepgram (TM Voice / Deepgram) — Member role key ---
DEEPGRAM_API_KEY=

# --- ElevenLabs (TM Voice / ElevenLabs) — TTS-scoped key ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- LLM (TM Voice / LLM) — mini tier ---
LLM_PROVIDER=anthropic                                       # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Resend (TM Voice / Resend) — sending_access restricted to mail.transparentmaintenance.com ---
RESEND_API_KEY=
MAIL_FROM=Transparent Maintenance <booking@mail.transparentmaintenance.com>

# --- Microsoft Graph (TM Voice / Microsoft Graph) — Entra app tm-voice-agent, certificate credential, RBAC-scoped to booking@ ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_CERT_PEM=                                          # PEM with newlines escaped as \n; rotate at 24 months
MS_BOOKING_MAILBOX=booking@transparentmaintenance.com

# --- Cloudflare R2 (TM Voice / Cloudflare) — Object Read & Write token on bucket tm-call-recordings ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tm-call-recordings

# --- DoNotCallDNC (TM Voice / DNC) — $100 prepaid lookup block. Not required while DNC_SCRUB=off ---
DNC_API_KEY=
